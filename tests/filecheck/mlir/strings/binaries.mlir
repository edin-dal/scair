// Binary payloads survive byte for byte, whatever their size.

// RUN: mlir-opt %s --allow-unregistered-dialect --mlir-print-op-generic | filecheck %s --strict-whitespace
// RUN: scair-opt %s --allow-unregistered-dialect --print-generic | filecheck %s --strict-whitespace
// RUN: scair-opt %s --allow-unregistered-dialect --print-generic -p 'mlir-opt[]' | filecheck %s --strict-whitespace

// CHECK: "builtin.module"() ({

// Headers of the formats exchanged through string attributes.
// ELF, 64-bit little endian
"test.op"() {s = "\7FELF\02\01\01\00\00\00\00\00\00\00\00\00"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\7FELF\02\01\01\00\00\00\00\00\00\00\00\00"} : () -> ()

// ELF for NVIDIA GPUs
"test.op"() {s = "\7FELF\02\01\01\33\07\00\00\00\00\00\00\00\02\00\BE\00"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\7FELF\02\01\013\07\00\00\00\00\00\00\00\02\00\BE\00"} : () -> ()

// ELF for AMD GPUs
"test.op"() {s = "\7FELF\02\01\01\40\03\00\00\00\00\00\00\00\03\00\E0\00"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\7FELF\02\01\01@\03\00\00\00\00\00\00\00\03\00\E0\00"} : () -> ()

// NVIDIA fatbin
"test.op"() {s = "\50\ED\55\BA\01\00\10\00"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "P\EDU\BA\01\00\10\00"} : () -> ()

// SPIR-V, little endian
"test.op"() {s = "\03\02\23\07\00\00\01\00"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\03\02#\07\00\00\01\00"} : () -> ()

// SPIR-V, big endian
"test.op"() {s = "\07\23\02\03\00\01\00\00"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\07#\02\03\00\01\00\00"} : () -> ()

// LLVM bitcode
"test.op"() {s = "BC\C0\DE\35\14\00\00\05\00\00\00"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "BC\C0\DE5\14\00\00\05\00\00\00"} : () -> ()

// LLVM bitcode wrapper
"test.op"() {s = "\DE\C0\17\0B\00\00\00\00"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\DE\C0\17\0B\00\00\00\00"} : () -> ()

// Mach-O
"test.op"() {s = "\CF\FA\ED\FE\07\00\00\01"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\CF\FA\ED\FE\07\00\00\01"} : () -> ()

// Java class
"test.op"() {s = "\CA\FE\BA\BE\00\00\00\41"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\CA\FE\BA\BE\00\00\00A"} : () -> ()

// PE
"test.op"() {s = "MZ\90\00\03\00\00\00\04\00\00\00\FF\FF\00\00"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "MZ\90\00\03\00\00\00\04\00\00\00\FF\FF\00\00"} : () -> ()

// PNG, with its line ending checks
"test.op"() {s = "\89PNG\0D\0A\1A\0A\00\00\00\0DIHDR"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\89PNG\0D\0A\1A\0A\00\00\00\0DIHDR"} : () -> ()

// gzip
"test.op"() {s = "\1F\8B\08\00\00\00\00\00\00\03"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\1F\8B\08\00\00\00\00\00\00\03"} : () -> ()

// zstd
"test.op"() {s = "\28\B5\2F\FD\04\00"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "(\B5/\FD\04\00"} : () -> ()

// Runs of zeros, as in padding and little-endian integers.
"test.op"() {s = "\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00\00"} : () -> ()

"test.op"() {s = "\01\00\00\00\02\00\00\00\FF\FF\FF\FF\00\00\80\3F"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\01\00\00\00\02\00\00\00\FF\FF\FF\FF\00\00\80?"} : () -> ()

// Byte patterns of line endings, which no text mode may normalize.
"test.op"() {s = "\0D\0A"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\0D\0A"} : () -> ()

"test.op"() {s = "\0A\0D"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\0A\0D"} : () -> ()

"test.op"() {s = "\0D\0D\0A"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\0D\0D\0A"} : () -> ()

"test.op"() {s = "a\0Db\0Ac\0D\0Ad"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "a\0Db\0Ac\0D\0Ad"} : () -> ()

"test.op"() {s = "\0A\0A\0A"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\0A\0A\0A"} : () -> ()

