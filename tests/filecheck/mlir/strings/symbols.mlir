// CHECK-NEXT:   "test.op"() {s = @"4a"} : () -> ()
"test.op"() {s = @"5a"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = @"5a"} : () -> ()
"test.op"() {s = @"6a"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = @"6a"} : () -> ()
"test.op"() {s = @"7a"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = @"7a"} : () -> ()
"test.op"() {s = @"8a"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = @"8a"} : () -> ()
"test.op"() {s = @"9a"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = @"9a"} : () -> ()
"test.op"() {s = @":a"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = @":a"} : () -> ()
"test.op"() {s = @";a"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = @";a"} : () -> ()
"test.op"() {s = @"<a"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = @"<a"} : () -> ()
"test.op"() {s = @"=a"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = @"=a"} : () -> ()
"test.op"() {s = @">a"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = @">a"} : () -> ()
"test.op"() {s = @"?a"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = @"?a"} : () -> ()
"test.op"() {s = @"@a"} : () -> ()
