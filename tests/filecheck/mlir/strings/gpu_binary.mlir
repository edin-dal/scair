// Offloaded binaries, as the plain string attributes that carry them.

// RUN: mlir-opt %s --allow-unregistered-dialect --mlir-print-op-generic | filecheck %s --strict-whitespace
// RUN: scair-opt %s --allow-unregistered-dialect --print-generic | filecheck %s --strict-whitespace
// RUN: scair-opt %s --allow-unregistered-dialect --print-generic -p 'mlir-opt[]' | filecheck %s --strict-whitespace

// CHECK: "builtin.module"() ({

// A device ELF image, a bitcode file, and the byte classes they mix.
"test.op"() {s = "\7FELF\02\01\013\07\00\00\00\00\00\00\00\02\00\BE\00"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\7FELF\02\01\013\07\00\00\00\00\00\00\00\02\00\BE\00"} : () -> ()

"test.op"() {s = "BC\C0\DE"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "BC\C0\DE"} : () -> ()

"test.op"() {s = "\C3\A9\FF\00"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\C3\A9\FF\00"} : () -> ()

"test.op"() {s = "\03\02#\07"} : () -> ()
// CHECK-NEXT:   "test.op"() {s = "\03\02#\07"} : () -> ()

// Several payloads in one array.
"test.op"() {s = ["BC\C0\DE", "\C3\A9\FF\00", "\03\02#\07"]} : () -> ()
// CHECK-NEXT:   "test.op"() {s = ["BC\C0\DE", "\C3\A9\FF\00", "\03\02#\07"]} : () -> ()

